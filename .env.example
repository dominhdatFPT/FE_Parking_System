# ====================================
# Environment Variables for Development
# ====================================

# API Base URL - Backend service.
# Leave empty to call /api on the same origin. Vite dev and nginx.conf proxy it to the backend.
VITE_API_BASE_URL=

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=git stash
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Stripe (lấy từ https://dashboard.stripe.com/test/apikeys — chỉ dùng Publishable Key phía FE)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51Tp3bHQb9gTBKSFRZus9wawQlvEsF7SM7yb9R6nd0r8mNcEKuuifpLFiVpUC0yKp8OgkwWN7qVGeni6JewyI8iSb00pRY5P2b8

# App Config
VITE_APP_NAME=Parking System
VITE_APP_VERSION=0.1.0
